# Vent Weaning Readiness Agent - Environment Configuration
# Copy this file to .env and fill in your values

# Required: HMAC-SHA256 audit trail secret key (minimum 32 characters)
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
AUDIT_SECRET_KEY=your-strong-secret-key-here-minimum-32-chars-long

# LLM provider: mock, ollama, claude, openai
MODEL_PROVIDER=mock
